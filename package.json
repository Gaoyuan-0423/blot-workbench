{
  "name": "blot-workbench",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "reviewer:dev": "tsx reviewer/server/index.ts",
    "reviewer:build": "tsc -p reviewer/tsconfig.json && vite build --config reviewer/vite.config.ts",
    "reviewer:start": "tsx reviewer/server/index.ts --production",
    "reviewer:test": "vitest run --config reviewer/vitest.config.ts",
    "reviewer:e2e": "playwright test --config reviewer/playwright.config.ts",
    "reviewer:evaluate": "tsx reviewer/scripts/evaluate.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "examples": "tsx scripts/generate-examples.ts",
    "test:scripts": "node --test scripts/*.check.mjs",
    "format": "prettier --write src tests scripts/generate-examples.ts *.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
