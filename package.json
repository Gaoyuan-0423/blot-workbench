{
  "name": "blot-workbench",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "reviewer:dev": "npm run dev --workspace blotlens",
    "reviewer:build": "npm run build --workspace blotlens",
    "reviewer:start": "npm run start --workspace blotlens",
    "reviewer:test": "npm run test --workspace blotlens",
    "reviewer:e2e": "npm run test:e2e --workspace blotlens",
    "reviewer:evaluate": "npm run evaluate --workspace blotlens",
    "dev": "tsx scripts/local-workbench.ts",
    "build": "tsc -b && vite build && npm run reviewer:build && node scripts/copy-blotlens.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "examples": "tsx scripts/generate-examples.ts",
    "test:scripts": "node --test scripts/*.check.mjs",
    "format": "prettier --write src tests scripts/generate-examples.ts *.ts",
    "start": "tsx scripts/local-workbench.ts --production"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "reviewer"
  ]
}
